PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/portfolio
# Frontend URL(s), comma separated. Only these sites may call the API.
CLIENT_ORIGIN=http://localhost:5173
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The ONLY account that can log in to /admin
ADMIN_EMAIL=hashirdev68@gmail.com
# Generate with: npm run hash -- "your-strong-password"   (never store the plain password)
ADMIN_PASSWORD_HASH=

# Cloudinary (free account at cloudinary.com) - needed only for image/resume uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set to production when deployed (enables Secure cookies)
NODE_ENV=development
